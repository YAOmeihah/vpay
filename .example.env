# 应用调试开关：本地开发可设为 true，生产环境建议 false
APP_DEBUG = false
# 应用密钥：用于加密和签名，生产环境请保持随机且不要泄露
APP_KEY = Wvf6QGW9RXF79av1RBUOZMXuh3cbIc
# Cookie 安全传输：true 表示仅通过 HTTPS 发送 Cookie
COOKIE_SECURE = true

# 缓存驱动：file 使用文件缓存，redis 使用 Redis 缓存
CACHE_DRIVER = file
# Redis 主机地址：CACHE_DRIVER=redis 时生效
CACHE_REDIS_HOST = 127.0.0.1
# Redis 端口：CACHE_DRIVER=redis 时生效
CACHE_REDIS_PORT = 6379
# Redis 密码：无密码时留空
CACHE_REDIS_PASSWORD =
# Redis 数据库编号：默认使用 0
CACHE_REDIS_SELECT = 0
# Redis 连接超时时间：0 表示使用默认/不额外限制
CACHE_REDIS_TIMEOUT = 0
# Redis 缓存 key 前缀：用于区分不同项目
CACHE_REDIS_PREFIX = vmq_
# Redis 是否使用持久连接：默认 false
CACHE_REDIS_PERSISTENT = false

# Session 驱动：默认 cache；可选 cache 或 file
SESSION_TYPE = cache
# Session 缓存连接：留空表示跟随默认缓存驱动
SESSION_STORE =

# 默认请求频率限制：旧全局限流的默认策略
SECURITY_RATE_LIMIT_DEFAULT_MAX_REQUESTS = 120
SECURITY_RATE_LIMIT_DEFAULT_WINDOW_SECONDS = 60
# 后台登录限流
SECURITY_RATE_LIMIT_ADMIN_LOGIN_MAX_REQUESTS = 5
SECURITY_RATE_LIMIT_ADMIN_LOGIN_WINDOW_SECONDS = 1800
# 后台接口限流
SECURITY_RATE_LIMIT_ADMIN_API_MAX_REQUESTS = 300
SECURITY_RATE_LIMIT_ADMIN_API_WINDOW_SECONDS = 60
# 商户接口限流
SECURITY_RATE_LIMIT_MERCHANT_API_MAX_REQUESTS = 120
SECURITY_RATE_LIMIT_MERCHANT_API_WINDOW_SECONDS = 60
# 监控端心跳限流
SECURITY_RATE_LIMIT_MONITOR_HEARTBEAT_MAX_REQUESTS = 30
SECURITY_RATE_LIMIT_MONITOR_HEARTBEAT_WINDOW_SECONDS = 60
# 监控端支付推送限流
SECURITY_RATE_LIMIT_MONITOR_PUSH_MAX_REQUESTS = 120
SECURITY_RATE_LIMIT_MONITOR_PUSH_WINDOW_SECONDS = 60
# 监控端查询/维护接口限流
SECURITY_RATE_LIMIT_MONITOR_QUERY_MAX_REQUESTS = 60
SECURITY_RATE_LIMIT_MONITOR_QUERY_WINDOW_SECONDS = 60

# 数据库类型：通常为 mysql
DB_TYPE = mysql
# 数据库主机地址
DB_HOST = 127.0.0.1
# 数据库名称
DB_NAME = test
# 数据库用户名
DB_USER = username
# 数据库密码
DB_PASS = password
# 数据库端口：MySQL 默认 3306
DB_PORT = 3306
# 数据库字符集
DB_CHARSET = utf8

# 默认语言：zh-cn 表示简体中文
DEFAULT_LANG = zh-cn
